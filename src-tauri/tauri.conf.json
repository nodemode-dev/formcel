{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormCel",
  "version": "0.40.8",
  "identifier": "ai.nodemode.formcel",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormCel",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "nodemode",
    "copyright": "Copyright 2026 nodemode. Apache-2.0.",
    "category": "Productivity",
    "shortDescription": "A local-first spreadsheet",
    "longDescription": "FormCel is a local-first spreadsheet. The window runs a Rust calculation engine compiled to WebAssembly, and a local engine process keeps your workbooks on this computer.",
    "license": "../LICENSE",
    "externalBin": ["binaries/formcel-engine"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "wix": { "language": "en-US" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": { "section": "science" },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
