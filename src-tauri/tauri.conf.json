{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormCel",
  "version": "0.35.0",
  "identifier": "ai.nodemode.formcel",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FormCel",
        "url": "http://127.0.0.1:8199/",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "nodemode",
    "copyright": "Copyright 2026 nodemode. Apache-2.0.",
    "category": "Productivity",
    "shortDescription": "A local-first spreadsheet",
    "longDescription": "FormCel is a local-first spreadsheet. The window runs a Rust calculation engine compiled to WebAssembly, and a local engine process keeps your workbooks on this computer.",
    "license": "../LICENSE",
    "resources": {
      "../backend/app": "engine/app",
      "../frontend/dist": "engine/window"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "wix": { "language": "en-US" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": { "depends": ["python3", "python3-pip"], "section": "science" },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
