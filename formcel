#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

pids=()
if [ -d backend ]; then
  ( cd backend && ./boot_backend ) &
  pids+=($!)
fi
if [ -d frontend ]; then
  ( cd frontend && ./boot_frontend ) &
  pids+=($!)
fi

kill_tree() {
  local p
  for p in $(pgrep -P "$1"); do kill_tree "$p"; done
  kill "$1" 2>/dev/null || true
}
trap 'for p in "${pids[@]}"; do kill_tree "$p"; done' EXIT
wait
