{
  "name": "formcel",
  "private": true,
  "version": "0.43.0",
  "description": "FormCel · spreadsheets in the form family",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:vba": "vite build --config vite.vba.config.ts",
    "demo": "vite build --config vite.demo.config.ts --mode sales && vite build --config vite.demo.config.ts --mode whatif && vite build --config vite.demo.config.ts --mode lab"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
